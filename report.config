# Official report fields. Use with --config-report report.config --report-out run.csv.
# Omit --timeseries for one whole-run aggregate; --timeseries 1 samples each second.
throughput_rps=true
latency_avg_ms=true
latency_p99_ms=true
entries_total=true
entries_stale=true
entries_live_tombstones=true
entries_live_normal=true
nodes=true
max_depth=true
upward_hops_avg=true
downward_hops_avg=true
page_cache_hits=true
page_cache_misses=true
page_cache_coalesced=true
page_cache_hit_ratio=true
rebalance_attempts=true
reinsertion_attempts=true
pruning_successes=true
migration_successes=true
